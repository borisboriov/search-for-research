# Прокси Search For Research (SFR-4 §1–2).
#
# SITE_ADDRESS: "search-for-research.ru" на бою (Caddy сам выпускает TLS,
# слушает 80/443) или "http://localhost:8080" на локальной репетиции
# (без TLS — префикс http:// отключает auto-HTTPS для этого сайта).
#
# Наружу смотрит только этот контейнер: api в compose-сети без
# опубликованных портов, все запросы к нему идут через web (Next).
#
# REDIRECT_FROM → REDIRECT_TO: постоянный редирект второго имени на
# канонический адрес (#21) — на бою www.search-for-research.ru →
# https://search-for-research.ru, а SITE_ADDRESS содержит только апекс.
# Одно имя в обоих блоках сразу — ошибка конфигурации, Caddy не стартует.
# Не заданы (локальная репетиция) — блок слушает http://localhost:8081, порт
# наружу не опубликован, репетицию он не трогает.

{
	# rate_limit — сторонний модуль, у него нет места в стандартном порядке
	order rate_limit before reverse_proxy
	# Apply the same closed diagnostic policy to error/runtime request logs.
	log default {
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
			request>uri regexp "\\?.*$" ""
		}
	}
}

{$SITE_ADDRESS} {
	encode gzip

	# Тела больше 16 КБ к нам не приходят легально: /api/match ограничен
	# 4 КБ на прокси Next и 2000 символами в API (эквивалент
	# client_max_body_size 16k из спеки).
	request_body {
		max_size 16KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Access-лог — закрытая диагностика HTTP. Воронка строится только
	# по явным событиям с visit_id/search_id, не по IP или Referer.
	log {
		output file /data/access.log {
			# Caddy 2.11.4 treats age=0 as 90 days. Operator rotation
			# closes/archives files explicitly, never expires history.
			roll_disabled
			mode 0600
		}
		format filter {
			wrap json
			# Closed context has a separate application allowlist. Headers never
			# enter access logs, including unknown authentication header names.
			request>headers delete
			resp_headers delete
			# No query parameter is safe by default (arbitrary secret names).
			request>uri regexp "\\?.*$" ""
		}
	}

	# Один rate_limit на уровне сайта, зоны различаются матчерами. Не через
	# handle-блоки: handle в порядке директив Caddy идёт раньше rate_limit,
	# и «внешние» зоны никогда не выполнялись бы (поймано на репетиции).
	#
	# /api/match: FRIDA на CPU — ~2 rps. Burst 10 за 10 секунд (скрипт) +
	# 30 в минуту устойчиво. Не 10/мин: за одним NAT-IP может сидеть целая
	# лаборатория (пилот в кампусе). Ботам лимит /api/match тоже действует —
	# поиску он не нужен, а спуферам UA нечего дарить.
	#
	# Страницы: 120/мин хватает живому человеку с запасом, но охлаждает
	# перебор /supervisor/* скриптом. Исключения из зоны pages:
	# - статика /_next/*: одна загрузка страницы тянет её десятками;
	# - поисковые боты по User-Agent (SEO — органический канал, NEXT.md).
	rate_limit {
		zone match_burst {
			match {
				method POST
				path /api/match
			}
			key {remote_host}
			events 10
			window 10s
		}
		zone match_sustained {
			match {
				method POST
				path /api/match
			}
			key {remote_host}
			events 30
			window 1m
		}
		zone analytics {
			match {
				method POST
				path /api/events
			}
			key {remote_host}
			events 120
			window 1m
		}
		zone pages {
			match {
				not path /_next/* /icon.svg /favicon.ico /api/events /api/match
				not header_regexp User-Agent (?i)(googlebot|yandex(bot|images|mobilebot)|bingbot|applebot|duckduckbot|baiduspider)
			}
			key {remote_host}
			events 120
			window 1m
		}
	}

	# Эквивалент nginx proxy_read_timeout из спеки: зависший upstream не
	# должен держать соединения на прокси (15-секундный AbortSignal внутри
	# Next покрывает только /api/match, не SSR-страницы).
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-SFR-Client-IP {remote_host}
		transport http {
			response_header_timeout 30s
		}
	}
}

# 301 на канонический адрес с сохранением пути и запроса: склеивает сигналы
# поисковиков на одно имя надёжнее, чем canonical (#21). TLS для www Caddy
# выпускает сам — как раньше, когда www стоял в SITE_ADDRESS.
{$REDIRECT_FROM:http://localhost:8081} {
	redir {$REDIRECT_TO:http://localhost:8080}{uri} permanent
}
