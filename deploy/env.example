# Скопировать в deploy/.env на сервере: cp env.example .env
# (.env в git не попадает; здесь — только имена и подсказки, без секретов)

# Домен сайта — только канонический адрес. Caddy сам выпустит TLS-сертификат,
# DNS A-запись должна уже указывать на сервер. Локальная репетиция:
# http://localhost:8080. Несколько имён через запятую допустимы (значение в
# кавычках, иначе `source .env` из README споткнётся о пробел), но второе имя
# лучше отдавать редиректом — REDIRECT_FROM ниже.
SITE_ADDRESS="search-for-research.ru"

# 301 второго имени на канонический адрес (#21). Имя из REDIRECT_FROM не
# должно стоять в SITE_ADDRESS: одно имя в двух блоках — Caddy не стартует.
# Пусто — редиректа нет (локальная репетиция).
REDIRECT_FROM=www.search-for-research.ru
REDIRECT_TO=https://search-for-research.ru

# Канонический адрес для canonical/OG/sitemap — инлайнится в сборку web.
NEXT_PUBLIC_SITE_URL=https://search-for-research.ru

# Адрес для «Это вы?» на странице НР; пусто — ссылка скрыта.
NEXT_PUBLIC_CLAIM_EMAIL=

# Секрет пост-деплойной ревалидации (openssl rand -hex 32); пусто — роут выключен.
REVALIDATE_SECRET=

# Соль хеша IP в логах /match (openssl rand -hex 16); без неё IPv4 перебираем.
SFR_API_LOG_SALT=

# Аналитика: три разных парольных секрета, hex безопасен внутри DSN.
# Генерировать отдельно openssl rand -hex 32; runtime не получает DDL-права.
SFR_ANALYTICS_MIGRATION_PASSWORD=
SFR_ANALYTICS_RUNTIME_PASSWORD=
SFR_ANALYTICS_READER_PASSWORD=
SFR_ANALYTICS_RELEASE=
# Позднее можно вынести PostgreSQL: изменить runtime, migration и operator подключения.
# SFR_API_ANALYTICS_DATABASE_URL=postgresql+psycopg://sfr_runtime:...@postgres:5432/sfr_analytics
# SFR_ANALYTICS_MIGRATION_DATABASE_URL=postgresql+psycopg://sfr_migrator:...@postgres:5432/sfr_analytics
# SFR_ANALYTICS_OPERATOR_DATABASE_URL=postgresql+psycopg://sfr_reader:...@postgres:5432/sfr_analytics
# Operator CLI читает SFR_ANALYTICS_OPERATOR_DATABASE_URL (роль читателя).
# Локальная репетиция параллельно другому стенду:
# SFR_COMPOSE_PROJECT=sfr-analytics-179
# SFR_LOCAL_PORT=18080
# SFR_COMPOSE_SUBNET=172.29.179.0/24
# SFR_COMPOSE_IP_RANGE=172.29.179.128/25
# SFR_COMPOSE_WEB_IP=172.29.179.3
