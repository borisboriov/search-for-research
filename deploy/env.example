# Скопировать в deploy/.env на сервере: cp env.example .env
# (.env в git не попадает; здесь — только имена и подсказки, без секретов)

# Домен сайта. Caddy сам выпустит TLS-сертификат, DNS A-запись должна уже
# указывать на сервер. Локальная репетиция: http://localhost:8080
SITE_ADDRESS=search-for-research.ru

# Канонический адрес для canonical/OG/sitemap — инлайнится в сборку web.
NEXT_PUBLIC_SITE_URL=https://search-for-research.ru

# Адрес для «Это вы?» на странице НР; пусто — ссылка скрыта.
NEXT_PUBLIC_CLAIM_EMAIL=

# Секрет пост-деплойной ревалидации (openssl rand -hex 32); пусто — роут выключен.
REVALIDATE_SECRET=

# Соль хеша IP в логах /match (openssl rand -hex 16); без неё IPv4 перебираем.
SFR_API_LOG_SALT=
