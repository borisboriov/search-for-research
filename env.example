# Скопировать в .env в корне репозитория: cp env.example .env
# (.env в git не попадает; здесь — только имена и подсказки, без секретов.
# Имя без точки — по образцу deploy/env.example: пример лежит в git, секретов
# в нём нет, и правило Read(.env.*) в .claude/settings.json его не закрывает.)

# Email for the OpenAlex polite pool (required — the ETL refuses to start without it).
OPENALEX_MAILTO=you@example.com
# Бесплатный ключ OpenAlex: квота $1/сутки (10 000 list-запросов) вместо $0,10
# анонимных — на анонимной выкачка каталога упирается в лимит (SFR-5).
# Завести: openalex.org/settings/api. Значение — только в .env, сюда не
# вставлять: env.example лежит в git.
OPENALEX_API_KEY=
# Database URL. SQLite file by default; PostgreSQL in production.
SFR_DB_URL=sqlite:///data/sfr.db

# --- SFR-2 search API (apps/api) -------------------------------------------
# Which index to serve; it is built offline by `make index-sfr5c`.
SFR_API_MODEL=frida
SFR_API_INDEX_ROOT=data/indexes_sfr5c
# Search backend: auto (faiss on Linux, numpy on macOS) | faiss | numpy
SFR_SEARCH_BACKEND=auto
# SFR-3: обогащение карточек (строится make export-sfr5c; опционально)
SFR_API_CARDS_PATH=data/exports/cards_sfr5c.jsonl
# SFR-3: фронт — адрес API для SSR/прокси и канонический адрес сайта
SFR_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLAIM_EMAIL=

# --- Пороги уверенности ----------------------------------------------------
# Намеренно закомментированы: рабочие значения живут в settings.py и меняются
# при каждой перекалибровке, а прописанные здесь числа молча перекрыли бы их
# у всех, кто скопировал этот файл. Раскомментировать только чтобы осознанно
# отойти от дефолта. Пороги принадлежат паре модель×индекс (сейчас
# frida_clean-9002p-35e591d4; у mpnet своя шкала) и отдаются в /api/health.
# Источник истины — ApiSettings (apps/api/src/sfr_api/settings.py); значения
# ниже — для справки, обоснование — §13.4 docs/reports/SFR5c_REPORT.md:
#   SFR_API_SCORE_THRESHOLD=0.33   «уверенных совпадений нет»
#   SFR_API_SCORE_WEAK=0.40        верх серой зоны
#   SFR_API_SCORE_HIGH=0.49        граница «высокого совпадения»

# --- SFR-4: защита и деплой ------------------------------------------------
# Соль хеша IP в логах /match (на сервере: openssl rand -hex 16)
SFR_API_LOG_SALT=
# Секрет пост-деплойной ревалидации фронта (openssl rand -hex 32);
# пусто — роут /api/revalidate выключен
REVALIDATE_SECRET=